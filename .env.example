# Local development only. Copy to .env; never commit the populated file.
POSTGRES_USER=copilot
POSTGRES_PASSWORD=
POSTGRES_DB=copilot
# Optional PostgreSQL URL override. Compose otherwise builds it safely from POSTGRES_*.
# Outside Compose, export DATABASE_URL in your shell; .env is not loaded automatically by Python.
DATABASE_URL=
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
